---
import Logo from './Logo.astro';
import { site } from '../data/site.js';
const { dock = false } = Astro.props;
---
<footer class:list={['bg-deep text-paper', dock && 'pb-20 lg:pb-0']}>
  <div class="wrap cols gap-y-10 py-14 small">
    <div class="col-span-full md:col-span-4 lg:col-span-5">
      <p class="brand"><Logo />{site.name}</p>
      <p class="mt-4 max-w-[38ch] text-mist">We match commercial buildings in Chicago and South Florida with one contractor per job.</p>
      <p class="mt-3 max-w-[38ch] text-mist">North Facilities is a referral service. We don't perform contracting work.</p>
    </div>
    <nav aria-label="Footer" class="col-span-2 grid content-start gap-3 font-semibold md:col-span-2 lg:col-span-3">
      <a href="/request/">{site.cta}</a>
      <a href="/contractors/">For contractors</a>
      <a href="/#faq">Questions</a>
    </nav>
    <div class="col-span-2 grid content-start gap-3 md:col-span-2 lg:col-span-4">
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {site.mailingAddress && <p class="text-mist">{site.mailingAddress}</p>}
      <p class="text-mist">Chicago, Miami-Dade and Broward</p>
    </div>
    <p class="col-span-full border-t border-paper/15 pt-6 text-mist">
      &copy; {new Date().getFullYear()} North Facilities.
    </p>
  </div>
</footer>
