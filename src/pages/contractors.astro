---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ContractorForm from '../components/ContractorForm.astro';
import { site } from '../data/site.js';

const promises = [
  { title: 'Pay per walkthrough', text: 'A flat fee only when the site visit happens. No retainer, no monthly bill.' },
  { title: 'Never shared', text: "Each job goes to one contractor. You're not racing four others to call back." },
  { title: 'Know the price first', text: 'The fee is set by trade and agreed before we send you anything.' },
  { title: 'Commercial only', text: 'Property managers, condo and HOA associations, and building owners.' },
];

const steps = [
  { title: 'Get on the list', text: 'Tell us your trade and area. We email you the fee for your trade.' },
  { title: 'Send your insurance', text: 'A current certificate. We need it before your first introduction.' },
  { title: 'We find the job', text: 'We reach buildings that need your trade and set up the walkthrough.' },
  { title: 'You show up and quote', text: 'The fee is due once the walkthrough happens. Winning the job is up to you.' },
];
---
<Base title="For contractors" description="North Facilities books commercial walkthroughs for contractors in Chicago and South Florida. Pay a flat fee per walkthrough. Each job goes to one contractor.">

  <section class="hero">
    <div class="hero-media"><Photo name="exterior" sizes="100vw" eager /></div>
    <div class="wrap cols items-center gap-y-10 py-10 md:py-16 lg:py-20">
      <div class="col-span-full lg:col-span-6">
        <p class="hero-note" style="border-radius: 0.875rem;"><i></i><span>For contractors</span></p>
        <h1 class="mt-6">Get walkthroughs, not leads.</h1>
        <p class="lede mt-5 max-w-[46ch]">We find commercial buildings that need your trade and book the site visit. You show up and quote.</p>
      </div>
      <div class="col-span-full lg:col-span-6">
        <div class="card card-lift hang p-5 md:p-7">
          <h2 class="text-[1.5rem] md:text-[1.75rem]" style="line-height: 1.12;">{site.contractorCta}</h2>
          <div class="mt-5"><ContractorForm id="pro-top" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="after-hang pb-4">
    <div class="wrap">
      <ul class="grid gap-x-8 gap-y-7 md:grid-cols-2 lg:grid-cols-4">
        {promises.map((p) => (
          <li class="border-t-[3px] border-ink pt-4">
            <h2 class="text-[1.25rem]" style="font-stretch: 110%; letter-spacing: -0.01em; line-height: 1.2;">{p.title}</h2>
            <p class="mt-2 max-w-[38ch] text-soft">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="dark plan-grid section mt-16 md:mt-20">
    <div class="wrap">
      <h2>How it works for you</h2>
      <ol class="route mt-12">
        {steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p class="mt-2 max-w-[36ch]">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-wash">
    <div class="wrap cols gap-y-8">
      <h2 class="col-span-full lg:col-span-4">Quick answers</h2>
      <div class="faq col-span-full lg:col-span-8">
        <details>
          <summary>What does a walkthrough cost?</summary>
          <div class="answer-text">A flat fee set by trade. We tell you the number before you say yes, and you only pay once the visit happens.</div>
        </details>
        <details>
          <summary>What counts as a walkthrough?</summary>
          <div class="answer-text">You meet the building contact on site, at the time we set, to look at the job and quote it. If they don't show, you don't pay.</div>
        </details>
        <details>
          <summary>Is the job shared with other contractors?</summary>
          <div class="answer-text">No. One contractor per job.</div>
        </details>
        <details>
          <summary>Do I have to sign a contract?</summary>
          <div class="answer-text">No long-term contract. Take the walkthroughs you want, pass on the ones you don't.</div>
        </details>
        <details>
          <summary>Which trades and areas?</summary>
          <div class="answer-text">Commercial cleaning, landscaping and snow, roofing, and masonry or exterior work, in the Chicago area, Miami-Dade and Broward.</div>
        </details>
      </div>
    </div>
  </section>
</Base>
