---
import Base from '../layouts/Base.astro';
import RequestForm from '../components/RequestForm.astro';
import { site } from '../data/site.js';
---
<Base
  title="Request a walkthrough"
  description="Tell us what your building needs. We find one insured commercial contractor and set up the walkthrough. Free for property managers."
>
  <div class="dark plan-grid">
    <div class="wrap pb-32 pt-12 md:pb-40 md:pt-20">
      <h1 class="max-w-[14ch]">{site.cta}</h1>
      <p class="lede mt-5 max-w-[44ch]">Five quick answers. We find one contractor and email you {site.replyTime}.</p>
    </div>
  </div>

  <section class="wrap -mt-20 pb-16 md:-mt-24 md:pb-24">
    <div class="cols items-start gap-y-10">
      <div class="card card-lift col-span-full p-5 md:p-9 lg:col-span-7">
        <RequestForm id="request" source="request" />
      </div>

      <aside class="col-span-full lg:col-span-4 lg:col-start-9 lg:pt-28">
        <h2 class="text-[1.5rem]">What happens next</h2>
        <ul class="checks mt-5">
          <li>We find one local, insured contractor for the job.</li>
          <li>We email you to set a walkthrough time.</li>
          <li>They visit and quote. You decide.</li>
        </ul>
        <h2 class="mt-10 text-[1.5rem]">Rather email?</h2>
        <p class="mt-3 max-w-[36ch]"><a href={`mailto:${site.email}`} class="font-semibold">{site.email}</a></p>
      </aside>
    </div>
  </section>
</Base>
